<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false" : le coffre ne doit jamais partir dans la sauvegarde Google.
     configChanges : l'activité n'est pas recréée en tournant l'écran, le coffre ouvert reste en mémoire.
     Réseau : synchronisation avec les PC sur le Wi-Fi de la maison seulement (localisation : lecture du
     nom du Wi-Fi, jamais d'une position) ; appareil photo : lecture du QR code d'appairage ;
     vibreur : choc de l'animation d'ouverture ; installation de paquets : mises à jour publiées sur GitHub.
     Aucune autorisation pour l'auto-remplissage : c'est l'utilisateur qui choisit KeePlus dans Android. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission android:name="android.permission.CAMERA" />
	<uses-permission android:name="android.permission.VIBRATE" />
	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
	<uses-feature android:name="android.hardware.camera" android:required="false" />

	<!-- Auto-remplissage : noms des applis de l'écran d'accueil, pour montrer « Ma Banque » plutôt
	     que « com.mabanque.app » dans les suggestions (rien d'autre n'est lu). -->
	<queries>
		<intent>
			<action android:name="android.intent.action.MAIN" />
			<category android:name="android.intent.category.LAUNCHER" />
		</intent>
	</queries>

	<application
		android:allowBackup="false"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:roundIcon="@mipmap/ic_launcher_round"
		android:supportsRtl="true"
		android:theme="@style/Theme.KeePlus">

		<activity
			android:name=".MainActivity"
			android:exported="true"
			android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
			android:windowSoftInputMode="adjustResize">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<!-- Auto-remplissage : service choisi par l'utilisateur dans les réglages d'Android (seul le
		     système peut s'y lier), et écran de déverrouillage et de choix ouvert par une suggestion. -->
		<service
			android:name=".autofill.KeeAutofillService"
			android:exported="true"
			android:label="@string/app_name"
			android:permission="android.permission.BIND_AUTOFILL_SERVICE">
			<intent-filter>
				<action android:name="android.service.autofill.AutofillService" />
			</intent-filter>
			<meta-data
				android:name="android.autofill"
				android:resource="@xml/autofill_service" />
		</service>

		<activity
			android:name=".autofill.AutofillActivity"
			android:exported="false"
			android:excludeFromRecents="true"
			android:taskAffinity=""
			android:theme="@style/Theme.KeePlus.Autofill"
			android:windowSoftInputMode="adjustResize" />

		<!-- Résultat de l'installeur du système pour une mise à jour. -->
		<receiver
			android:name=".UpdateInstallReceiver"
			android:exported="false">
			<intent-filter>
				<action android:name="fr.maubin.keeplus.action.INSTALL_STATUS" />
			</intent-filter>
		</receiver>
	</application>

</manifest>
