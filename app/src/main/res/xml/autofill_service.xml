<?xml version="1.0" encoding="utf-8"?>
<!-- Service d'auto-remplissage : réglages dans l'appli, suggestions aussi dans le clavier (Android 11 et plus).
     Mode de compatibilité pour les navigateurs qui ne transmettent pas leurs formulaires au service
     d'Android (Brave, Edge, Samsung Internet…) : Android reconstruit la page depuis l'accessibilité,
     le domaine est lu dans la barre d'adresse (identifiants fournis par Android). Chrome et Firefox s'en passent. -->
<autofill-service xmlns:android="http://schemas.android.com/apk/res/android"
	android:settingsActivity="fr.maubin.keeplus.MainActivity"
	android:supportsInlineSuggestions="true">
	<compatibility-package android:name="com.brave.browser" android:maxLongVersionCode="10000000000" />
	<compatibility-package android:name="com.brave.browser_beta" android:maxLongVersionCode="10000000000" />
	<compatibility-package android:name="com.brave.browser_nightly" android:maxLongVersionCode="10000000000" />
	<compatibility-package android:name="com.microsoft.emmx" android:maxLongVersionCode="10000000000" />
	<compatibility-package android:name="com.sec.android.app.sbrowser" android:maxLongVersionCode="10000000000" />
	<compatibility-package android:name="com.sec.android.app.sbrowser.beta" android:maxLongVersionCode="10000000000" />
	<compatibility-package android:name="com.opera.browser" android:maxLongVersionCode="10000000000" />
	<compatibility-package android:name="com.vivaldi.browser" android:maxLongVersionCode="10000000000" />
	<compatibility-package android:name="com.kiwibrowser.browser" android:maxLongVersionCode="10000000000" />
	<compatibility-package android:name="com.duckduckgo.mobile.android" android:maxLongVersionCode="10000000000" />
	<compatibility-package android:name="app.vanadium.browser" android:maxLongVersionCode="10000000000" />
</autofill-service>
